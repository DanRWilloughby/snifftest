#!/bin/sh
#
# Sniff Test pre-commit hook.
#
# Checks the prose you are about to commit against your house rules. By default
# it runs the countable rules only, so nothing leaves your machine and the hook
# costs nothing but a few milliseconds.
#
# Install, from the root of your repository, one command:
#
#   curl -fsSL https://raw.githubusercontent.com/DanRWilloughby/snifftest/v0.1.0/hooks/pre-commit \
#     -o .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Skip it once:   SNIFFTEST_SKIP=1 git commit …     (git commit --no-verify also works)
#
# Two things here are deliberate and worth knowing before you change them.
#
# It checks the *staged* content, not what is sitting in your working tree. A
# file you half-staged is checked as it will be committed, so the hook never
# blocks a commit over a sentence you did not include in it.
#
# It never sends anything unless you say so twice: `SNIFFTEST_SEND=1` in the
# environment *and* a key in `TYPESAFE_API_KEY`. Miss either and it quietly
# falls back to the free rules rather than failing or, worse, asking.
#
# Environment
#   SNIFFTEST_SKIP=1        skip the hook entirely
#   SNIFFTEST_SEND=1        run the judgment rules too (needs TYPESAFE_API_KEY).
#                           The value names where you are answering for, and 1
#                           is the shorthand for TypeSafe, which is the only
#                           place this hook ever sends.
#   SNIFFTEST_STRICT=1      treat a tool failure as a reason to block the commit
#   SNIFFTEST_THRESHOLD=…   the probability at or above which a judgment counts
#   SNIFFTEST_VERSION=…     the version fetched when snifftest is not installed
#   SNIFFTEST_BIN=…         an absolute path to the executable to run

SNIFFTEST_VERSION="${SNIFFTEST_VERSION:-0.1.0}"

if [ "${SNIFFTEST_SKIP:-0}" = "1" ]; then
  echo "snifftest: skipped (SNIFFTEST_SKIP=1)." >&2
  exit 0
fi

# Added, copied, modified or renamed; deletions have nothing left to read.
staged=$(
  git diff --cached --name-only --diff-filter=ACMR -z |
    tr '\0' '\n' |
    grep -Ei '\.(md|markdown|txt)$'
) || staged=''

# Nothing anybody writes prose in. Leave without spawning a thing.
[ -n "$staged" ] || exit 0

tmp=$(mktemp -d 2>/dev/null || mktemp -d -t snifftest) || {
  echo "snifftest: no temporary directory available; skipping the check." >&2
  exit 0
}
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

# The ruleset travels with the drafts: the staged copy of it, so a commit that
# changes a rule is checked against the rule as committed.
extract=$staged
for candidate in .snifftest.yaml .snifftest.yml; do
  if git ls-files --error-unmatch "$candidate" >/dev/null 2>&1; then
    extract="$candidate
$extract"
  fi
done

# The staged files go in one subdirectory and the captured output in another, so
# nothing the hook writes can ever be mistaken for something you staged.
tree="$tmp/tree"
out="$tmp/stdout"
err="$tmp/stderr"

printf '%s\n' "$extract" | tr '\n' '\0' | git checkout-index -z --stdin --prefix="$tree/" || {
  echo "snifftest: could not read the staged files; skipping the check." >&2
  exit 0
}

# --- what to run ------------------------------------------------------------

# A repository you are committing to is usually one you wrote, but a first
# commit in a repository you cloned is not, and two ordinary conveniences hand
# that repository a shell.
#
# `command -v snifftest` reaches its `node_modules/.bin`, which is on PATH
# whenever a package script or a hook manager put it there. And a package
# manager asked for `snifftest@<version>` while standing in a checkout runs that
# checkout's own `node_modules/snifftest` without ever reaching a registry. So a
# candidate that resolves inside the repository is refused, and the fetch is
# made from a scratch directory with the tree named by `--root` instead.

guard=$(git rev-parse --show-toplevel 2>/dev/null) || guard=''
[ -z "$guard" ] || guard=$(cd "$guard" && pwd -P)

scratch="$tmp/fetch"
mkdir -p "$scratch"

inside_guard() {
  [ -n "$guard" ] || return 1
  candidate=$(cd "$(dirname "$1")" 2>/dev/null && pwd -P) || return 1
  case $candidate in
    "$guard" | "$guard"/*) return 0 ;;
  esac
  return 1
}

run_snifftest() {
  if [ -n "${SNIFFTEST_BIN:-}" ]; then
    (cd "$scratch" && "$SNIFFTEST_BIN" "$@")
    return $?
  fi

  found=$(command -v snifftest 2>/dev/null) || found=''
  if [ -n "$found" ] && inside_guard "$found"; then
    echo "snifftest: ignoring the snifftest inside this repository; it is what you are committing." >&2
    found=''
  fi

  if [ -n "$found" ]; then
    (cd "$scratch" && "$found" "$@")
  elif command -v bunx >/dev/null 2>&1; then
    (cd "$scratch" && bunx "snifftest@$SNIFFTEST_VERSION" "$@")
  elif command -v npx >/dev/null 2>&1; then
    (cd "$scratch" && npx --yes "snifftest@$SNIFFTEST_VERSION" "$@")
  else
    return 127
  fi
}

set -- check

# SNIFFTEST_SEND names the destinations it answers for. `1` is the shorthand
# for TypeSafe, which is the only place `check` sends, and it is what this hook
# documents; a longer list is somebody answering for a bench run elsewhere.
case "${SNIFFTEST_SEND:-}" in
  "" | 0) asked_to_send=0 ;;
  *) asked_to_send=1 ;;
esac

if [ "$asked_to_send" = "1" ] && [ -n "${TYPESAFE_API_KEY:-}" ]; then
  : # SNIFFTEST_SEND is already in the environment; the CLI reads it as the yes.
else
  if [ "$asked_to_send" = "1" ]; then
    echo "snifftest: SNIFFTEST_SEND is set but TYPESAFE_API_KEY is empty. Running the free rules only." >&2
  fi
  set -- "$@" --dry-run
fi

if [ -n "${SNIFFTEST_THRESHOLD:-}" ]; then
  set -- "$@" --threshold "$SNIFFTEST_THRESHOLD"
fi

# The staged copies are what is checked, and the run happens outside them, so
# the extraction root is named rather than stood in. Paths still print the way
# you staged them, because they are still reported relative to that root.
set -- "$@" --root "$tree"

# Newline is the only separator, so a path with a space in it survives.
old_ifs=$IFS
IFS='
'
# shellcheck disable=SC2086 -- the split is the point, and IFS is a newline.
set -- "$@" -- $staged
IFS=$old_ifs

# Output is captured rather than streamed because the decision below depends on
# reading it.
run_snifftest "$@" > "$out" 2> "$err"
status=$?

cat "$out"
cat "$err" >&2

# --- what the exit code means -----------------------------------------------

# A flag as the checker prints one: path, line, rule id, probability, message.
FLAG_LINE='^[^[:space:]]+:[0-9]+ [^[:space:]]+ [01]\.[0-9][0-9] '

# The checker never got as far as an opinion about the prose. Anything that
# fetches the package can fail this way: an unpublished or mistyped version, a
# registry that is down, a proxy that says no. Every one of those exits 1,
# which is also the code for "your draft trips a rule". Blaming the prose for a
# 404 is the worst thing this hook could do, so the output decides, not the code.
not_run() {
  echo "snifftest: the checker did not run (exit $1). The commit was not blocked." >&2
  echo "           Its output is above. If it could not fetch the package, check" >&2
  echo "           SNIFFTEST_VERSION, or install snifftest and put it on PATH." >&2
  echo "           Set SNIFFTEST_STRICT=1 to treat this as a failure." >&2
  [ "${SNIFFTEST_STRICT:-0}" = "1" ] && exit 1
  exit 0
}

case $status in
  0)
    exit 0
    ;;
  1)
    if grep -Eq "$FLAG_LINE" "$out"; then
      echo "snifftest: the staged prose trips the rules above." >&2
      echo "           Fix it, or commit anyway with SNIFFTEST_SKIP=1 or --no-verify." >&2
      exit 1
    fi
    not_run "$status"
    ;;
  3)
    echo "snifftest: the judgment rules need a yes before anything is sent." >&2
    echo "           Set SNIFFTEST_SEND=1, or leave it and get the free rules." >&2
    exit 1
    ;;
  127)
    echo "snifftest: not installed and neither bunx nor npx is on PATH." >&2
    echo "           Install it (npm i -g snifftest) or remove .git/hooks/pre-commit." >&2
    [ "${SNIFFTEST_STRICT:-0}" = "1" ] && exit 1
    exit 0
    ;;
  *)
    # A broken tool is not evidence of a bad draft, and a hook that wedges every
    # commit in the repository is worse than one that says so and steps aside.
    echo "snifftest: could not finish (exit $status); the commit was not blocked." >&2
    echo "           Set SNIFFTEST_STRICT=1 to treat this as a failure." >&2
    [ "${SNIFFTEST_STRICT:-0}" = "1" ] && exit 1
    exit 0
    ;;
esac
