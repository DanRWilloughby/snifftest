{
  "name": "snifftest",
  "version": "0.0.0",
  "description": "Does the draft pass the sniff test? A prose linter for your house rules.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "rules",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "devDependencies": {
    "@types/bun": "1.3.6",
    "typescript": "5.9.2"
  }
}
